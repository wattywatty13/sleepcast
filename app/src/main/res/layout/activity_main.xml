<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="#E6E1D6"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#7D8594"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:textColor="#C9A96E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/now_playing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E6E1D6"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/queue_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#7D8594"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/show_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#7D8594"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/download_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#7D8594"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_pause"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Pause"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Next episode"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#8A3B2E"
            android:text="Stop (good morning)"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Start bedtime queue"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/allow_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:buttonTint="#C9A96E"
            android:text="Allow streaming on mobile data (off = only play downloaded episodes when away from Wi-Fi)"
            android:textColor="#7D8594"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="Settings: podcast feed &amp; episode range"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Podcast RSS feed URL"
                android:textColor="#C9A96E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/feed_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://example.com/feed.xml"
                android:inputType="textUri"
                android:textColor="#E6E1D6"
                android:textColorHint="#555C69"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="From episode"
                android:textColor="#C9A96E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/min_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="1"
                android:inputType="number"
                android:textColor="#E6E1D6"
                android:textColorHint="#555C69"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="To episode (0 = no limit)"
                android:textColor="#C9A96E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/max_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="700"
                android:inputType="number"
                android:textColor="#E6E1D6"
                android:textColorHint="#555C69"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Episodes per night"
                android:textColor="#C9A96E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/queue_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="20"
                android:inputType="number"
                android:textColor="#E6E1D6"
                android:textColorHint="#555C69"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="How to number episodes"
                android:textColor="#C9A96E"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/numbering"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Save &amp; start" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Reset defaults" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
